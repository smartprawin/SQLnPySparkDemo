{
    "$schema": "https://opencode.ai/config.json",
    "model": "ollama/qwen2.5-coder:latest",
    "provider": {
        "ollama": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Ollama (local)",
            "options": {
                "baseURL": "http://localhost:11434/v1"
            },
            "model": {
                "qwen2.5-coder:latest": {
                    "name": "Qwen 2.5 Coder",
                    "tool_call": true,
                    "limit": {
                        "context": 16384,
                        "output": 4096
                    }
                }
            }
        }
    }
}